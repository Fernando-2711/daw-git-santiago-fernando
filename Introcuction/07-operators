// Operadores aritmeticos

let a=5;
let b=10;

console.log(a+b);//Suma
console.log(a-b);//Resta
console.log(a*b);//Multiplicación
console.log(a/b);//División
console.log(a%b);//Módulo
console.log(a**b);//Exponente

a++;
console.log(a);//Incremento
console.log(++a);//Incremento

b--;
console.log(b);//Decremento
console.log(--b);//Decremento

// Operadores de asignación
let myVariable = 2;
console.log(myVariable);
myVariable += 2;//Suma con asignacion
console.log(myVariable);
myVariable -= 2;//Resta con asignacion
console.log(myVariable);
myVariable *= 2;//Multiplicación con asignacion
console.log(myVariable);
myVariable /= 2;//División con asignacion
console.log(myVariable);
myVariable %= 2;//Módulo con asignacion
console.log(myVariable);
myVariable **= 2;//Exponente con asignacion
console.log(myVariable);

// Operadores de comparación
let x = 5;
let y = 10;

console.log(x > y);//Mayor que
console.log(x < y);//Menor que
console.log(x >= y);//Mayor o igual que
console.log(x <= y);//Menor o igual que
console.log(x == y);//Igualdad
console.log(x != y);//Desigualdad
console.log(x === y);//Identidad
console.log(x !== y);//No identidad
